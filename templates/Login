{% extends "base.html" %}
{% block content %}
<h2>Log in</h2>
<form method="post">
  <label>Email</label>
  <input type="email" name="email" required>

  <label>Password</label>
  <input type="password" name="password" required>

  <button type="submit">Log in</button>
</form>
<p><a href="{{ url_for('signup') }}">Need an account? Sign up</a></p>
{% endblock %}
